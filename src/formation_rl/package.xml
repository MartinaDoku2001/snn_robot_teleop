<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>formation_rl</name>
  <version>0.1.0</version>
  <description>PPO controller for the centralized formation task (contract v2.0).</description>
  <maintainer email="martina.doku.t7@dc.tohoku.ac.jp">Martina Doku</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>formation_core</exec_depend>
  <!-- torch and gymnasium are installed by the Dockerfile, not by rosdep:
       neither has a rosdep key on Humble. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
